# Language Proficiency Center (LPC), Bangladesh - Environment Configuration

# Application Environment ('development' | 'production' | 'staging')
NODE_ENV=development

# Institution Base Configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_INSTITUTION_TIMEZONE=Asia/Dhaka

# Demo Mode Toggle (MUST be false in production; prevents fake authentication in live deployments)
NEXT_PUBLIC_DEMO_MODE=true

# Supabase Auth & PostgreSQL Database (Required for Production Backend)
# In production, missing credentials must cause server endpoints to fail closed.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-placeholder

# SUPABASE SERVICE ROLE KEY (SERVER-ONLY: Never expose to client bundles or browser)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-placeholder

# Admissions Notification Webhook / Email Service
ADMISSIONS_NOTIFICATION_EMAIL=admissions@lpcbd.org

